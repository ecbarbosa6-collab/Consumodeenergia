print ("Calculadora de Consumo de Energia")

aparelho = input ("nome do aparelho: ")
potencia = float (input(f"potencia do aparelho em watts (W): "))
hora_dia = float (input(f"tempo médio de uso diario (horas): "))

# calculo do consumo mensal (fwh)
# formula: (watts * hora * 30 dias) / 1000
consumo_mensal = (potencia * hora_dia * 30) / 1000

valor_kwh = 0.75
custo_estimado = consumo_mensal * valor_kwh

print("\n" + "=" * 30)
print(f"aparelho: {aparelho}")
print(f"consumo estimado: {consumo_mensal:.2f} kwh/mes")
print(f"custo mensal estimado: R$ {custo_estimado:.2f}")
print("="*30)
